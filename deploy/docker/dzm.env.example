# Copy to dzm.env and fill in. Never commit dzm.env.
# 32 random bytes, base64 (e.g. `openssl rand -base64 32`). Keep a copy: backups need it.
DZM_SECRET_KEY=
# Where admins open the panel, and where the game server's @DZMBridge sends data
# (both https, may be the same host).
DZM_PUBLIC_URL=https://dzm.example.com
DZM_INGEST_PUBLIC_URL=https://dzm.example.com
DZM_TZ=Europe/London
# DZM_MAP_MAX_PX=10000
# Accounts are built in (password or Steam, optional per-account 2FA). After the first
# start: docker exec dzm dzm admin invite-owner
# DZM_STEAM_LOGIN=0
# Optional single sign-on through an OpenID Connect provider: a confidential
# client with redirect URI <DZM_PUBLIC_URL>/auth/callback. Roles stay in DZ Manager.
# DZM_OIDC_ISSUER=https://sso.example.com/application/o/dz-manager/
# DZM_OIDC_CLIENT_ID=
# DZM_OIDC_CLIENT_SECRET=
# DZM_OIDC_LABEL=Single sign-on
