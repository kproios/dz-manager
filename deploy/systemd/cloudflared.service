[Unit]
Description=DZ Manager Cloudflare Tunnel
Wants=network-online.target
After=network-online.target networking.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=notify
ExecStart=/usr/bin/cloudflared --no-autoupdate --metrics 127.0.0.1:20241 tunnel run --token-file /etc/dzm/cloudflared-token
Restart=on-failure
RestartSec=5
TimeoutStartSec=90
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=multi-user.target
